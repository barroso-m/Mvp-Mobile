# Copiar a .env y completar con credenciales reales de la cuenta de prueba
TEST_EMAIL=usuario@ejemplo.com
TEST_PASSWORD=tu_password
ANDROID_AVD=Pixel_7_API_34

# Zephyr config (opcional — si no están seteadas, no se sube reporte)
ZEPHYR_PROJECT_KEY=IE
ZEPHYR_FOLDER_ID=
ZEPHYR_AUTH_TOKEN=

# Gmail API (OTP de email para la suite de Onboarding)
# El refresh token se saca una sola vez con los scripts de Intramed.MVP-Web
# (utils/gmail-auth-url.js + utils/gmail-get-refresh-token.js).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_TEST_INBOX=automationintramed@gmail.com

# Cuenta ya existente, para el caso de "email ya registrado" (TC46)
ONBOARDING_EMAIL_REGISTRADO=cuenta.existente@ejemplo.com
